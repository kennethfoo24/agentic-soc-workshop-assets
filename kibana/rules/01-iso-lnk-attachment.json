{
  "rule_id": "elastibank-lab-01-iso-lnk-attachment",
  "name": "Elastibank - ISO or LNK attachment delivered",
  "description": "A message carrying an ISO or LNK attachment reached a mailbox. Disk images and shortcuts are a common way to deliver payloads past mark-of-the-web controls.",
  "type": "query",
  "language": "kuery",
  "query": "email_gateway.verdict : \"delivered\" and email.attachments.file.name : (*.iso or *.lnk)",
  "index": [
    "logs-email_gateway.*"
  ],
  "from": "now-72h",
  "to": "now",
  "interval": "5m",
  "enabled": true,
  "severity": "low",
  "risk_score": 21,
  "max_signals": 100,
  "author": [
    "Elastibank Lab"
  ],
  "tags": [
    "Elastibank Lab"
  ],
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0001",
        "name": "Initial Access",
        "reference": "https://attack.mitre.org/tactics/TA0001/"
      },
      "technique": [
        {
          "id": "T1566",
          "name": "Phishing",
          "reference": "https://attack.mitre.org/techniques/T1566/",
          "subtechnique": [
            {
              "id": "T1566.001",
              "name": "Spearphishing Attachment",
              "reference": "https://attack.mitre.org/techniques/T1566/001/"
            }
          ]
        }
      ]
    }
  ]
}
